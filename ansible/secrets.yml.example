# Copy this file to secrets.yml, then encrypt it with:
# ansible-vault encrypt secrets.yml
k3s_token: REPLACE_WITH_EXISTING_K3S_TOKEN
k3s_datastore_endpoint: mysql://k3s:REPLACE_WITH_MARIADB_PASSWORD@tcp(192.168.x.x:3306)/k3s
powerdns_postgresql_password: REPLACE_WITH_POWERDNS_POSTGRESQL_PASSWORD
powerdns_api_key: REPLACE_WITH_A_RANDOM_POWERDNS_API_KEY
postgresql_ha_superuser_password: REPLACE_WITH_POSTGRES_SUPERUSER_PASSWORD
postgresql_ha_replication_password: REPLACE_WITH_REPLICATION_PASSWORD
postgresql_ha_restapi_password: REPLACE_WITH_PATRONI_REST_API_PASSWORD
postgresql_ha_etcd_root_password: REPLACE_WITH_ETCD_ROOT_PASSWORD
postgresql_ha_etcd_password: REPLACE_WITH_ETCD_PATRONI_USER_PASSWORD
# SOC agent (setup-soc-agent.yml). The app password is the same value as the
# Bitwarden secret behind authentik-soc-agent in gitops (Authentik user soc-agent).
soc_agent_app_password: REPLACE_WITH_THE_AUTHENTIK_APP_PASSWORD
# Private key of the soc-agent GitHub App (installed on rgorme/gitops only).
soc_agent_github_app_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  REPLACE_WITH_THE_APP_PRIVATE_KEY
  -----END RSA PRIVATE KEY-----
