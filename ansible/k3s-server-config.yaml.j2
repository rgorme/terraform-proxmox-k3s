disable:
  - traefik
tls-san:
  - {{ k3s_api_endpoint_host | to_json }}
token: {{ k3s_token | to_json }}
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"
datastore-endpoint: {{ k3s_datastore_endpoint | to_json }}
kube-apiserver-arg:
  - {{ ('oidc-issuer-url=' ~ k3s_oidc_issuer_url) | to_json }}
  - {{ ('oidc-client-id=' ~ k3s_oidc_client_id) | to_json }}
  - {{ ('oidc-username-claim=' ~ k3s_oidc_username_claim) | to_json }}
  - "oidc-username-prefix=oidc:"
  - {{ ('oidc-groups-claim=' ~ k3s_oidc_groups_claim) | to_json }}
  - "oidc-groups-prefix=oidc:"
