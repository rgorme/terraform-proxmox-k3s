# Managed by Ansible (secrets.yml). Read by soc-agent.service only.
SOC_AGENT_APP_PASSWORD={{ soc_agent_app_password }}
# GitHub as the soc-agent App (soc-agent[bot]); its private key is a separate file.
SOC_AGENT_GITHUB_APP_CLIENT_ID={{ soc_agent_github_app_client_id }}
SOC_AGENT_GITHUB_APP_KEY_FILE=/etc/soc-agent/github-app.pem
# Claude API through Workload Identity Federation (no API key): the agent
# fetches an Authentik token for the "anthropic" app and the SDK exchanges it.
ANTHROPIC_FEDERATION_RULE_ID={{ soc_agent_anthropic_federation_rule_id }}
ANTHROPIC_ORGANIZATION_ID={{ soc_agent_anthropic_organization_id }}
