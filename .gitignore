# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Except example tfvars file
!terraform.tfvars.example

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore any local backup files
*.backup

# Ignore any local environment files
.env
.env.*

# Ignore any local IDE files
.vscode/
.idea/
*.swp
*.swo

# Local Ansible credentials and encrypted cluster secrets
ansible/ansible.cfg
ansible/secrets.yml

# Ignore any local OS files
.DS_Store
Thumbs.db 